# UniFi Documenter Environment Configuration
# Copy this file to .env and fill in your values

# ===== SCHEDULE CONFIGURATION =====
# How often to run the backup analysis
# Options: daily, weekly, monthly
SCHEDULE_FREQUENCY=daily

# What time to run (24-hour format: HH:MM)
SCHEDULE_TIME=02:00

# For weekly: which day (1=Monday, 7=Sunday)
# For monthly: which day of month (1-31)
SCHEDULE_DAY=1

# Timezone for scheduling (e.g., UTC, America/New_York, Europe/London)
TIMEZONE=UTC

# ===== UDM CONFIGURATION =====
# IP address of your UniFi Dream Machine
UDM_IP=192.168.1.1

# Root password for SSH access to UDM
UDM_ROOT_PASSWORD=your_password_here

# Directory on UDM where backup files are stored
REMOTE_BACKUP_DIR=/usr/lib/unifi/data/backup/autobackup

# ===== AI CONFIGURATION =====
# AI provider to use for analysis
# Options: openai, azure-openai, ollama, custom
AI_PROVIDER=openai

# API URL for AI service
AI_API_URL=https://api.openai.com/v1

# API key for AI service
AI_API_KEY=your_openai_api_key_here

# Model to use for analysis
AI_MODEL=gpt-4o-mini

# Context window size (total tokens the model supports)
# Examples: 4096, 8192, 32768, 128000
# Set this to match your model's context window
AI_CONTEXT_WINDOW=128000

# Maximum tokens for AI completion/output
# Must be less than AI_CONTEXT_WINDOW
AI_MAX_TOKENS=4000

# Cooldown delay (in seconds) between LLM generation calls
# Set to 0 to disable (default). Useful for reducing VRAM pressure on local models.
# Recommended: 2-5 seconds for local models with limited VRAM
AI_COOLDOWN_SECONDS=0

# ===== OLLAMA CONFIGURATION (if using Ollama) =====
# URL of Ollama server
OLLAMA_URL=http://localhost:11434

# Ollama model to use
OLLAMA_MODEL=llama3

# ===== EMBEDDING / RAG CONFIGURATION =====
# Enable embedding-based RAG pipeline (requires Qdrant)
EMBEDDING_ENABLED=true

# Embedding provider: ollama, openai, custom
EMBEDDING_PROVIDER=ollama

# Embedding model (must be supported by the chosen provider)
# Ollama:  nomic-embed-text (~274 MB VRAM), all-minilm (~45 MB)
# OpenAI:  text-embedding-3-small, text-embedding-3-large
EMBEDDING_MODEL=nomic-embed-text

# Qdrant vector database URL (provided by docker-compose)
QDRANT_URL=http://localhost:6333

# Qdrant collection name for storing embeddings
EMBEDDING_COLLECTION=unifi_configs

# Number of similar documents to retrieve for context
EMBEDDING_TOP_K=5

# ===== AZURE OPENAI CONFIGURATION (if using Azure OpenAI) =====
# Azure OpenAI endpoint
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# Azure OpenAI API version
AZURE_OPENAI_API_VERSION=2024-02-01

# Azure OpenAI deployment name
AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# ===== OUTPUT CONFIGURATION =====
# Output format for documentation
# Options: markdown, json, both
OUTPUT_FORMAT=markdown

# Maximum size for individual documents (characters)
MAX_DOCUMENT_SIZE=50000

# Include raw JSON data in output
# Options: true, false
INCLUDE_RAW_DATA=false

# ===== RUNTIME CONFIGURATION =====
# Run mode: scheduled or once
# scheduled = run on schedule, once = run once and exit
RUN_MODE=scheduled

# Run immediately on startup (in addition to schedule)
# Options: true, false
RUN_IMMEDIATELY=false